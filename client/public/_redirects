# Recover from legacy Wrangler redirects that sent SPA routes to /app
/app        /admin/     301
/app/       /admin/     301

# Review SPA shell for /review/:orderId (and /review/). Never target /app.html —
# Wrangler pretty-URLs that to /app, which then redirects to /admin/.
/review/*   /review/index.html   200
