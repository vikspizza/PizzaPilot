# Cloudflare Pages Functions Local Development Variables
# Copy this file to .dev.vars and fill in your values
# .dev.vars is gitignored and used by Wrangler for local testing
# See SECURITY.md for rotation and secret handling.

DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# Optional: admin kitchen password (never commit a real value)
ADMIN_PASSWORD=change-me

# Optional: order confirmation emails (Resend — https://resend.com)
RESEND_API_KEY=
# Must be an address on a domain you verified in Resend — NOT @gmail.com.
# Production: Vik's Pizza <orders@vikspizza.com>
# Local testing only: Vik's Pizza <onboarding@resend.dev> (delivers only to your Resend signup email)
EMAIL_FROM=Vik's Pizza <onboarding@resend.dev>
SITE_URL=https://your-site.pages.dev

# Optional: dedicated secret for review email links (falls back to ADMIN_PASSWORD)
# REVIEW_LINK_SECRET=change-me-review-links

